{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Juniper Café, the demo site app-directory reviewers use to try the Editlayer connector.
  // The HTML files here are the source. After changing them run pwa.py, then `node ../engine/cli/editlayer.mjs
  // annotate` (both idempotent), then npx wrangler deploy.
  "name": "editlayer-demo",
  "account_id": "d06c70a0b6279642a6243926161f574b",
  "compatibility_date": "2026-11-01",
  "main": "cms.worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/icons/*", "!/styles.css", "!/favicon.svg", "!/apple-touch-icon.png", "!/robots.txt", "!/sw.js", "!/manifest.webmanifest"]
  },
  "routes": [
    // A zone route beside the custom domain, so a wildcard Worker on the zone can't catch POSTs.
    { "pattern": "demo.editlayer.co", "custom_domain": true },
    { "pattern": "demo.editlayer.co/*", "zone_name": "editlayer.co" }
  ],
  // */5: the engine's scheduled publishing and clean-up. 40 4: the nightly demo reset (cms.worker.js).
  "triggers": { "crons": ["*/5 * * * *", "40 4 * * *"] },
  "d1_databases": [
    { "binding": "CMS_DB", "database_name": "editlayer-demo-cms", "database_id": "61ca9564-b043-46c2-a575-f68a9fd87afe", "migrations_dir": "_editlayer/migrations" }
  ],
  "r2_buckets": [{ "binding": "CMS_MEDIA", "bucket_name": "editlayer-demo-cms-media" }],
  "observability": { "enabled": true }
}
